   "entity": "invoice_line",
   "label": "Gross margin",
   "unit": "currency",
   "synonyms": [
    "profit"
   ],
   "default_time_dimension": "invoice.invoice_date",
   "metric_type": "simple",
   "additivity": "additive",
   "polarity": "higher_is_better",
   "business_definition": "Line revenue minus line cost. Only lines with a cost are included; the answer states coverage."
  },
  {
   "id": "gross_margin_pct",
   "entity": "invoice_line",
   "label": "Gross margin %",
   "unit": "percent",
   "default_time_dimension": "invoice.invoice_date",
   "metric_type": "ratio",
   "additivity": "non_additive",
   "polarity": "higher_is_better"
  },
  {
   "id": "payments_received",
