   "unit": "currency",
   "synonyms": [
    "collections"
   ],
   "default_time_dimension": "payment.payment_date",
   "metric_type": "simple",
   "additivity": "additive",
   "polarity": "higher_is_better"
  },
  {
   "id": "outstanding_receivables",
   "entity": "invoice",
   "label": "Outstanding receivables",
   "unit": "currency",
   "synonyms": [
    "dues",
    "receivables",
    "outstanding"
   ],
   "default_time_dimension": "invoice.invoice_date",
   "metric_type": "simple",
   "additivity": "semi_additive",
   "polarity": "lower_is_better",
   "business_definition": "Invoice net amount minus allocated payments. Without allocation data, falls back to customer balance and says so."
  },
  {
   "id": "overdue_receivables",
   "entity": "invoice",
   "label": "Overdue receivables",
   "unit": "currency",
   "default_time_dimension": "invoice.due_date",
   "metric_type": "simple",
   "additivity": "semi_additive",
   "polarity": "lower_is_better",
   "business_definition": "Outstanding receivables on invoices past their due date by more than the overdue_days rule."
  },
  {
   "id": "days_sales_outstanding",
   "entity": "invoice",
   "label": "Days sales outstanding",
   "unit": "days",
   "default_time_dimension": "invoice.invoice_date",
   "metric_type": "derived",
   "additivity": "non_additive",
   "polarity": "lower_is_better",
   "drivers": [
    {
     "components": [
      "outstanding_receivables",
      "revenue"
     ]
    }
   ]
  }
 ],
