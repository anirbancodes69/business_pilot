    "invoice.invoice_date",
    "product.category",
    "product.sub_category",
    "product.name",
    "product.brand",
    "branch.name",
    "customer.name"
   ],
   "drivers": [
    {
     "components": [
      "units_sold",
      "average_selling_price"
     ]
    }
   ]
  },
  {
   "id": "units_sold",
   "entity": "invoice_line",
   "label": "Units sold",
   "unit": "quantity",
   "default_time_dimension": "invoice.invoice_date",
   "metric_type": "simple",
   "additivity": "additive",
   "polarity": "higher_is_better"
  },
  {
   "id": "average_selling_price",
   "entity": "invoice_line",
   "label": "Average selling price",
   "unit": "currency",
   "default_time_dimension": "invoice.invoice_date",
   "metric_type": "ratio",
   "additivity": "non_additive",
   "polarity": "higher_is_better"
  },
  {
