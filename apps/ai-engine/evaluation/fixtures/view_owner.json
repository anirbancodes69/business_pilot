   "id": "revenue",
   "entity": "invoice",
   "label": "Revenue",
   "unit": "currency",
   "synonyms": [
    "sales",
    "turnover"
   ],
   "default_time_dimension": "invoice.invoice_date",
   "metric_type": "simple",
   "additivity": "additive",
   "polarity": "higher_is_better",
   "business_definition": "Invoice net amount as synced from the source. Whether it includes tax depends on the source mapping.",
   "valid_dimensions": [
    "invoice.invoice_date",
    "branch.name",
    "branch.state",
    "customer.name",
    "customer.segment",
    "customer.city",
    "invoice.status"
   ],
   "breakdown_measure": "line_revenue"
  },
  {
   "id": "invoice_count",
   "entity": "invoice",
   "label": "Invoice count",
   "unit": "count",
   "default_time_dimension": "invoice.invoice_date",
   "metric_type": "simple",
   "additivity": "additive",
   "polarity": "higher_is_better"
  },
  {
   "id": "average_order_value",
   "entity": "invoice",
   "label": "Average order value",
   "unit": "currency",
   "default_time_dimension": "invoice.invoice_date",
