# BusinessPilot — example environment (PLACEHOLDERS ONLY)
# Copy to .env for local development. Never commit .env. Never put real credentials in this file.
# Create .env with random local secrets via ./scripts/setup-local-env.sh.
# Optional (have defaults): API_PORT, WORKER_HEALTH_PORT, OTEL_TRACES_EXPORTER (otlp|console|none).

# --- General ---
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=businesspilot
# Runtime role (no table ownership, no BYPASSRLS)
POSTGRES_APP_USER=bp_app
POSTGRES_APP_PASSWORD=<set-locally>
# Login for the worker's tenant-list sweeper (ADR-0017). Read by the worker only.
POSTGRES_SYSTEM_PASSWORD=<set-locally>
# Migration/owner role
POSTGRES_OWNER_USER=bp_owner
POSTGRES_OWNER_PASSWORD=<set-locally>

# Optional: password of the bootstrap superuser (administration only). Defaults to POSTGRES_OWNER_PASSWORD.
# POSTGRES_ADMIN_PASSWORD=<set-locally>

# --- Redis Stack ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=<set-locally>

# --- Object storage ---
# For the api run on the host. dummy = in memory, not durable (ADR-0015). local = files under
# OBJECT_STORAGE_LOCAL_DIR (ADR-0016). The Compose stack always uses local on a shared volume.
# The S3 settings below are not used yet (D-OPEN-24).
OBJECT_STORAGE_DRIVER=dummy
# OBJECT_STORAGE_LOCAL_DIR=<absolute-path>
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=businesspilot-local
S3_ACCESS_KEY_ID=<set-locally>
S3_SECRET_ACCESS_KEY=<set-locally>
S3_REGION=<region>

# --- Service-to-service ---
API_BASE_URL=http://localhost:3001
AI_ENGINE_BASE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=<generate-locally>
REQUEST_CONTEXT_SIGNING_KEY=<generate-locally>

# --- Key management (local adapter only; use KMS in shared environments) ---
KMS_PROVIDER=local
LOCAL_KEK_BASE64=<generate-locally-32-bytes-base64>
# Connector egress guard: leave false. Set true only to reach a local database in development.
CONNECTOR_ALLOW_PRIVATE_NETWORKS=false

# --- Identity provider (OIDC). Local development uses the Keycloak in the Compose stack (ADR-0016) ---
OIDC_ISSUER_URL=http://localhost:8080/realms/businesspilot
OIDC_CLIENT_ID=businesspilot
# Where the api containers fetch Keycloak's signing keys (they cannot reach localhost:8080).
# Leave empty for an external provider, or when the api runs on the host.
OIDC_JWKS_URL=http://keycloak:8080/realms/businesspilot/protocol/openid-connect/certs
# Password of the Keycloak admin console user `admin`.
KEYCLOAK_ADMIN_PASSWORD=<set-locally>

# --- AI providers (D-OPEN-01 / D-OPEN-02; ai-engine only) ---
# LLM_PROVIDER=dummy is the only provider for now: no model is called (ADR-0015).
LLM_PROVIDER=dummy
LLM_API_KEY=<set-locally>
LLM_MODEL_PLANNER=<model-id>
LLM_MODEL_EXPLAINER=<model-id>
EMBEDDING_PROVIDER=<provider>
EMBEDDING_MODEL=<model-id>

# --- Google Sheets connector (Milestone 9) ---
GOOGLE_OAUTH_CLIENT_ID=<client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<set-locally>

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=<service-name>
