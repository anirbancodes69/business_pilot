{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:businesspilot:schemas:semantic-model:semantic-model",
  "x-version": "0.2.0",
  "title": "SemanticModel",
  "description": "A tenant's versioned business vocabulary over canonical entities. Immutable once published (P-13). Physical mappings and measure expressions here are visible only to the api plan compiler, never to the LLM. v0.2.0 adds the ADR-0013 extensions (additivity, polarity, drivers, hierarchies, business rules).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "template",
    "settings",
    "entities",
    "measures",
    "dimensions"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "template": {
      "type": "string",
      "examples": [
        "wholesale_distribution@0"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "timezone",
        "fiscal_year_start_month"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "INR"
        },
        "timezone": {
          "type": "string",
          "default": "Asia/Kolkata"
        },
        "fiscal_year_start_month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 4
        },
        "number_format": {
          "enum": [
            "indian",
            "international"
          ],
          "default": "indian"
        },
        "business_rules": {
          "type": "array",
          "description": "Named parameters such as overdue_days. Values in answers carry config provenance.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "value",
              "unit"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "enum": [
                  "currency",
                  "count",
                  "percent",
                  "days",
                  "quantity"
                ]
              }
            }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "table"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "table": {
            "type": "string",
            "description": "Canonical table, e.g. analytics.invoice. Compiler-only."
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "description": "The only join paths the compiler may use.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "on",
          "cardinality"
        ],
        "properties": {
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          },
          "on": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/column"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "cardinality": {
            "enum": [
              "many_to_one",
              "one_to_many",
              "one_to_one"
            ]
          }
        }
      }
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "entity",
          "aggregation",
          "unit",
          "metric_type",
          "additivity",
          "polarity"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "entity": {
            "$ref": "#/$defs/id"
          },
          "aggregation": {
            "enum": [
              "sum",
              "count",
              "count_distinct",
              "avg",
              "min",
              "max",
              "ratio",
              "custom"
            ]
          },
          "attribute": {
            "$ref": "#/$defs/column"
          },
          "numerator": {
            "$ref": "#/$defs/id"
          },
          "denominator": {
            "$ref": "#/$defs/id"
          },
          "expression_ref": {
            "type": "string",
            "description": "For aggregation=custom: ID of a vetted compiler-side expression; never free SQL."
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "attribute",
                "operator",
                "values"
              ],
              "properties": {
                "attribute": {
                  "$ref": "#/$defs/column"
                },
                "operator": {
                  "enum": [
                    "eq",
                    "neq",
                    "in",
                    "not_in",
                    "is_null",
                    "is_not_null"
                  ]
                },
                "values": {
                  "type": "array"
                }
              }
            }
          },
          "unit": {
            "enum": [
              "currency",
              "count",
              "percent",
              "days",
              "quantity"
            ]
          },
          "default_time_dimension": {
            "type": "string"
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "enum": [
                "pii",
                "sensitive",
                "financial"
              ]
            }
          },
          "metric_type": {
            "enum": [
              "simple",
              "ratio",
              "derived"
            ]
          },
          "additivity": {
            "enum": [
              "additive",
              "semi_additive",
              "non_additive"
            ],
            "description": "semi_additive: a balance, never summed over time."
          },
          "polarity": {
            "enum": [
              "higher_is_better",
              "lower_is_better",
              "neutral"
            ]
          },
          "valid_dimensions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
            }
          },
          "formula_ref": {
            "type": "string",
            "description": "For metric_type=derived: ID of a vetted formula in the code registry; never free expressions."
          },
          "drivers": {
            "type": "array",
            "description": "Declared decomposition, e.g. revenue = quantity x average price.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "formula_ref",
                "components"
              ],
              "properties": {
                "formula_ref": {
                  "type": "string"
                },
                "components": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            }
          },
          "business_definition": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "certified": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "entity",
          "attribute",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "entity": {
            "$ref": "#/$defs/id"
          },
          "attribute": {
            "$ref": "#/$defs/column"
          },
          "type": {
            "enum": [
              "categorical",
              "time",
              "numeric",
              "boolean"
            ]
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "enum": [
                "pii",
                "sensitive"
              ]
            }
          },
          "hierarchy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "level"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/id"
              },
              "level": {
                "type": "integer",
                "minimum": 1
              }
            },
            "description": "Dimensions sharing a name form a hierarchy ordered by level (1 = top)."
          },
          "diagnostic": {
            "type": "boolean",
            "default": false
          },
          "member_synonyms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "member",
                "synonyms"
              ],
              "properties": {
                "member": {
                  "type": "string"
                },
                "synonyms": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "definition"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "maps_to": {
            "type": "string",
            "pattern": "^(measure|dimension|entity):[a-z0-9_.]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "column": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "description": "A physical column name. Plain lower-case identifiers only: the plan compiler turns it into an SQL identifier."
    }
  }
}
